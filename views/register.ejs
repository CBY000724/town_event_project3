<%- include("partials/header") %>
<section class="panel login">
  <h1>동네소식 회원가입</h1>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <form class="fields" action="/register" method="post">
    <label>아이디<input name="username" value="<%= username %>" autocomplete="username" required minlength="3" maxlength="30"></label>
    <label>비밀번호<input name="password" type="password" autocomplete="new-password" required minlength="8" maxlength="72"></label>
    <label>비밀번호 확인<input name="password2" type="password" autocomplete="new-password" required minlength="8" maxlength="72"></label>
    <button class="button" type="submit">회원가입</button>
  </form>
  <a class="outline" href="/login">로그인으로 돌아가기</a>
</section>
<%- include("partials/footer") %>
