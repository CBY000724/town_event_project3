<%- include("partials/header") %>
<article class="panel">
  <a class="back" href="/">← 행사 목록</a>
  <p class="tag"><%= event.category %></p>
  <h1><%= event.title %></h1>
  <dl class="metadata">
    <div><dt>일정</dt><dd><time datetime="<%= event.event_date %>"><%= event.event_date %></time></dd></div>
    <div><dt>장소</dt><dd><%= event.location %></dd></div>
    <div><dt>작성자</dt><dd><%= event.nickname %></dd></div>
  </dl>
  <p class="description"><%= event.description %></p>
  <div class="actions wrap-actions">
    <% if (user) { %>
      <form action="/events/<%= event.id %>/like" method="post">
        <input type="hidden" name="formToken" value="<%= formToken %>">
        <input type="hidden" name="liked" value="<%= event.liked ? 0 : 1 %>">
        <button class="outline" aria-pressed="<%= Boolean(event.liked) %>" type="submit"><%= event.liked ? '♥' : '♡' %> 좋아요 <%= event.like_count %></button>
      </form>
    <% } else { %>
      <a class="outline" href="/login">♡ 좋아요 <%= event.like_count %> · 로그인</a>
    <% } %>
    <% if (user?.id === event.user_id) { %>
      <a class="outline" href="/events/<%= event.id %>/edit">수정</a>
      <form action="/events/<%= event.id %>/delete" method="post" data-confirm>
        <input type="hidden" name="formToken" value="<%= formToken %>">
        <button class="outline error" type="submit">삭제</button>
      </form>
    <% } %>
  </div>
  <section id="comments" class="comments">
    <h2>댓글 <%= comments.length %></h2>
    <% for (const comment of comments) { %>
      <div class="comment"><strong><%= comment.nickname %></strong><p><%= comment.body %></p></div>
    <% } %>
    <% if (!comments.length) { %><p>아직 댓글이 없어요.</p><% } %>
    <% if (user) { %>
      <form class="fields" action="/events/<%= event.id %>/comments" method="post">
        <input type="hidden" name="formToken" value="<%= formToken %>">
        <label>댓글 남기기<textarea name="body" required maxlength="300" rows="2"></textarea></label>
        <button class="button" type="submit">댓글 등록</button>
      </form>
    <% } else { %>
      <a href="/login">로그인하고 댓글 남기기</a>
    <% } %>
  </section>
</article>
<script src="/detail.js" defer></script>
<%- include("partials/footer") %>
