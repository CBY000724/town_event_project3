<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · 동네소식</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="top">
  <nav class="wrap nav" aria-label="주 메뉴">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>동네소식</a>
    <div class="actions">
      <% if (user) { %>
        <form action="/logout" method="post">
          <input type="hidden" name="formToken" value="<%= formToken %>">
          <button class="plain" type="submit">로그아웃</button>
        </form>
      <% } else { %>
        <a class="plain" href="/login">로그인</a>
      <% } %>
      <a class="button" href="/events/new">행사 등록</a>
    </div>
  </nav>
</header>
<main class="wrap">
